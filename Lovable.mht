1 0 0 / 0.16)) 0px 0.5px 0px 0px inset, light-dark(oklch(0 0 0 / 0.16), oklch(1 0 0 / 0.04)) 0px -0.5px 0px 0px inset;"></span><span data-button-content="" class="xl56j7k xrj38xe btn-content"><span data-button-label="" class="xbwgavj">Preview</span></span></button></div></div></div></div></div></div></div><div dir="auto" data-selectable="true" class="min-w-0 break-words typestyle-prose-base prose-chat max-w-full"><p dir="ltr">I've built the full PIXELIA website. I checked every page in a test browser, and they all load with no errors and look right on computers and phones.</p>
<p dir="ltr"><strong>What's on the site:</strong></p>
<ul dir="ltr">
<li><strong>Pages:</strong><span> Home, Services, Pricing, Portfolio, About, FAQ and Contact, all reachable from the menu, which collapses into a tap-to-open menu on phones. Nothing mentions AI anywhere.</span></li>
<li><strong>The four studios</strong><span> (Web, Digital, Creative, Growth), each with its services and a "from" price where one makes sense.</span></li>
<li><strong>Packages:</strong><span> Starter £249, Professional £549 (marked "Most popular") and Premium £999, plus prices for single services and a custom-quote option. Clicking a package opens the contact form with that package already chosen.</span></li>
<li><strong>Portfolio:</strong><span> four example projects, each clearly labelled as a demonstration project. Testimonials are clearly labelled as placeholders.</span></li>
<li><strong>Dark and light mode:</strong><span> the sun/moon button switches between them, and the site remembers the visitor's choice.</span></li>
<li><strong>Language button:</strong><span> the globe button offers over 100 languages with a search box. I tested it in French and the page translated. No provider name appears anywhere.</span></li>
<li><strong>Client Hub:</strong><span> an internal page at </span><code dir="auto">/dashboard</code><span>, not linked from the menu and hidden from search engines. It holds the client details you listed plus a 10-step onboarding checklist, and it counts paying clients against your goals of 1, 3 and 5. I tested adding a client, and it was still there after reloading. It saves only in the browser you use, so download a backup now and then with the Export button.</span></li>
</ul>
<p dir="ltr"><strong>Two things you need to do:</strong></p>
<ol dir="ltr">
<li><strong>Turn on the enquiry form.</strong><span> It uses FormSubmit, a free email service, to send enquiries to </span><a href="mailto:rayhanadenga0@gmail.com" target="_blank" rel="noopener noreferrer">rayhanadenga0@gmail.com</a><span>. I sent one test enquiry, which made FormSubmit email you an "Activate Form" link. Click it once and enquiries will start arriving. Until then, visitors who submit see a message asking them to email you directly.</span></li>
<li><strong>Send me your WhatsApp number</strong><span>, with the country code (for example 447700900123). The green WhatsApp button is showing, but for now it opens the contact page. Once I have your number it will open a WhatsApp chat with you.</span></li>
</ol></div><div class="mr-1 w-full max-w-sm"><div class="flex flex-col gap-3"><div class="grid grid-cols-3 gap-2"><button type="button" aria-label="Open portfolio-brand.jpg" title="portfolio-brand.jpg" class="group/media-tile rounded-2 focus-visible:ring-focus-pulse relative cursor-pointer overflow-hidden transition-colors outline-none focus-visible:ring-2 disabled:cursor-default after:pointer-events-none after:absolute after:inset-0 after:rounded-[inherit] after:shadow-[inset_0_0_0_var(--border-default)_var(--border-glow-on-accent)] aspect-square w-full"><span data-pulse="skeleton" data-pulse-layer="pattern" data-pulse-modified="className render" class="x1prsk10 x10l74o8 xo6bm9r x351c3 x1c74tu6 xw1l40g xa4qsjk x1rg5ohu absolute inset-0 rounded-none"></span><img alt="" loading="lazy" class="absolute inset-0 size-full object-cover transition-opacity duration-300 opacity-0" crossorigin="anonymous" src="https://storage.googleapis.com/gpt-engineer-file-uploads/42ecd6a2-62c0-4dd9-bfb0-26e5b8dbb2b8/image-gen/99e9b836-f11d-41c1-a503-174b12caf9f0?X-Goog-Algorithm=GOOG4-RSA-SHA256&amp;X-Goog-Credential=go-api%40lovable-core-prod.iam.gserviceaccount.com%2F20261115%2Fauto%2Fstorage%2Fgoog4_request&amp;X-Goog-Date=20261115T142041Z&amp;X-Goog-Expires=3599&amp;X-Goog-&amp;X-Goog-SignedHeaders=host"><span aria-hidden="true" class="hover-feedback pointer-events-none absolute inset-0 transition-colors group-hover/media-tile:bg-black/10 group-hover/media-tile:duration-0"></span></button><button type="button" aria-label="Open portfolio-store.jpg" title="portfolio-store.jpg" class="group/media-tile rounded-2 focus-visible:ring-focus-pulse relative cursor-pointer overflow-hidden transition-colors outline-none focus-visible:ring-2 disabled:cursor-default after:pointer-events-none after:absolute after:inset-0 after:rounded-[inherit] after:shadow-[inset_0_0_0_var(--border-default)_var(--border-glow-on-accent)] aspect-square w-full"><span data-pulse="skeleton" data-pulse-layer="pattern" dat